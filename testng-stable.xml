<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- STABLE suite: everything except tests tagged "known-defect". Used by CI so the build stays green. -->
<suite name="SauceDemo Stable Regression Suite">
    <test name="Stable Regression (45 test cases)">
        <groups>
            <run>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="com.esha.saucedemo.tests.LoginTests"/>
            <class name="com.esha.saucedemo.tests.ProductTests"/>
            <class name="com.esha.saucedemo.tests.SortingTests"/>
            <class name="com.esha.saucedemo.tests.CartTests"/>
            <class name="com.esha.saucedemo.tests.CheckoutTests"/>
            <class name="com.esha.saucedemo.tests.LogoutTests"/>
        </classes>
    </test>
</suite>
